# Efficiency gate (overall >= 95% strict).
# highestUserWastedPercent is tuned to 0.18 (from 0.05) because daily
# `apt-get -y upgrade` and `debconf` metadata updates on `debian:trixie-slim`
# necessarily overwrite ~5 MB of base-layer files against a compact ~38 MB
# user delta (~97.8% overall efficiency, ~13.3–13.6% of user bytes).
rules:
  lowestEfficiency: 0.95
  highestUserWastedPercent: 0.18
