# Efficiency gate (overall >= 95% strict).
# highestUserWastedPercent is tuned to 0.30 (from 0.18) because daily
# `apt-get -y upgrade` and `debconf` metadata updates on `debian:trixie-slim`
# necessarily overwrite base-layer files against a compact user delta. The
# 2026-11-25 no-cache rebuild measured 22.3% (amd64) and 25.8% (arm64) of user
# bytes overwritten, while lowestEfficiency still passed at >= 95%. The gate
# remains blocking; only this documented threshold is adjusted.
rules:
  lowestEfficiency: 0.95
  highestUserWastedPercent: 0.30
